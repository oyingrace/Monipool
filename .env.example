# ─────────────────────────────────────────
# MoniPool Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# ── BITNOB ──────────────────────────────
# Get sandbox key at: https://bitnob.com/developers
BITNOB_API_KEY=your_bitnob_sandbox_key_here
BITNOB_WEBHOOK_SECRET=your_bitnob_webhook_secret_here
BITNOB_BASE_URL=https://sandboxapi.bitnob.co/api/v1
# Switch to https://api.bitnob.co/api/v1 for production

# ── BREEZ SDK ───────────────────────────
# Get API key at: https://sdk.breez.technology
BREEZ_API_KEY=your_breez_api_key_here
BREEZ_NETWORK=testnet
# Switch to mainnet for production

# ── NOSTR ───────────────────────────────
# Service keypair — generate once and keep secret
# Generate with: node -e "const {generateSecretKey,getPublicKey}=require('nostr-tools'); const k=generateSecretKey(); console.log({priv:Buffer.from(k).toString('hex'),pub:getPublicKey(k)})"
NOSTR_SERVICE_PRIVKEY=your_service_nostr_privkey_hex_here
NOSTR_SERVICE_PUBKEY=your_service_nostr_pubkey_hex_here
NOSTR_RELAY_PRIMARY=wss://relay.damus.io
NOSTR_RELAY_FALLBACK=wss://nos.lol

# ── DATABASE ─────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/monipool
# For production, use a managed DB (Railway, Supabase, Neon)

# ── APP ──────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── RATE LIMITS ──────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
