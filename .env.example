# ─────────────────────────────────────────────────────────────────────────────
# MoniPool Environment Variables
# Copy this file to .env (for Prisma CLI) and .env.local (for Next.js)
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Get a free PostgreSQL DB at https://neon.tech
DATABASE_URL=postgresql://postgres:password@localhost:5432/monipool

# ── BITNOB ────────────────────────────────────────────────────────────────────
# Sign up at https://bitnob.com/developers → Sandbox credentials
# Auth: HMAC-SHA256 — signature = HMAC(SECRET_KEY, timestamp + clientId + body)
BITNOB_CLIENT_ID=your_client_id_here
BITNOB_SECRET_KEY=your_secret_key_here
BITNOB_LIGHTNING_KEY=your_lightning_key_here      # separate key for Lightning endpoints
BITNOB_WEBHOOK_SECRET=your_bitnob_webhook_secret_here
BITNOB_BASE_URL=https://sandboxapi.bitnob.co/api/v1
# Switch to https://api.bitnob.co/api/v1 for production

# ── BREEZ SDK ─────────────────────────────────────────────────────────────────
# Sign up at https://sdk.breez.technology
BREEZ_API_KEY=your_breez_api_key_here
BREEZ_NETWORK=testnet
# Generate mnemonic: node -e "const b=require('bip39'); console.log(b.generateMnemonic())"
# This IS the pool wallet — keep it secret and back it up
BREEZ_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── NOSTR ─────────────────────────────────────────────────────────────────────
# Generate keypair: node -e "const {generateSecretKey,getPublicKey}=require('nostr-tools'); const k=generateSecretKey(); console.log({priv:Buffer.from(k).toString('hex'),pub:getPublicKey(k)})"
NOSTR_SERVICE_PRIVKEY=your_64_char_hex_private_key
NOSTR_SERVICE_PUBKEY=your_64_char_hex_public_key
NOSTR_RELAY_PRIMARY=wss://relay.damus.io
NOSTR_RELAY_FALLBACK=wss://nos.lol

# Exposed to browser (public — no secrets)
NEXT_PUBLIC_NOSTR_RELAY=wss://relay.damus.io
NEXT_PUBLIC_NOSTR_SERVICE_PUBKEY=your_64_char_hex_public_key

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_secret
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_32_byte_hex_secret

# ── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
